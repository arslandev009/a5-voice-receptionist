      {
        "parameters": {
          "jsCode": "   const msg = ($('Webhook').first().json.body || {}).message || {};\n   const calls = Array.isArray(msg.toolCallList) ? msg.toolCallList : [];\n   const routes = { check_availability: 'check-availability', book_appointment: 'book-appointment' };\n   if (msg.type !== 'tool-calls' || calls.length === 0) return [{ json: { skip: true } }];\n   return calls.map(c => {\n     const name = c.name || (c.function && c.function.name);\n     let args = c.arguments || (c.function && c.function.arguments) || {};\n     if (typeof args === 'string') { try { args = JSON.parse(args); } catch (e) { args = {}; } }\n     return { json: { toolCallId: c.id, name, args, route: routes[name] || null } };\n   });"
        },
