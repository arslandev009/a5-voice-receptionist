      {
        "parameters": {
          "jsCode": "const calls = $('Parse').all().map(i => i.json);\nif (calls.length === 1 && calls[0].skip) return [{ json: { results: [] } }];\nconst replies = $input.all().map(i => i.json);\nconst results = calls.map((c, idx) => {\n  const r = replies[idx] || {};\n  let result;\n  if (!c.route) result = JSON.stringify({ error: 'unknown_tool', tool: c.name });\n  else if (r.error) result = JSON.stringify({ error: 'backend_error' });\n  else result = JSON.stringify(r);\n  return { toolCallId: c.toolCallId, result };\n});\nreturn [{ json: { results } }];"
        },
