      {
        "parameters": {
          "jsCode": "   const b = $('Webhook').first().json.body || {};\n   const bad = (detail) => [{ json: { valid: false, detail } }];\n   const date = b.date, time = b.time;\n   const name = typeof b.patient_name === 'string' ? b.patient_name.trim() : '';\n   const phone = typeof b.phone === 'string' ? b.phone.trim() : '';\n   if (typeof date !== 'string' || !/^\\d{4}-\\d{2}-\\d{2}$/.test(date)) return bad('date');\n   if (typeof time !== 'string' || !/^([01]\\d|2[0-3]):[0-5]\\d$/.test(time)) return bad('time');\n   if (name.length < 1 || name.length > 60) return bad('patient_name');\n   if (!/^[0-9+\\-\\s]{7,20}$/.test(phone)) return bad('phone');\n   return [{ json: { valid: true, date, time, patient_name: name, phone } }];"
        },
