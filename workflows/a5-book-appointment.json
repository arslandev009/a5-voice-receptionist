      {
        "parameters": {
          "jsCode": "   const req = $('Validate').first().json;\n   const done = $input.all().some(i => {\n     const r = i.json;\n     return r.date === req.date && r.time === req.time && r.status === 'booked' && r.patient_name === req.patient_name;\n   });\n   return [{ json: done\n     ? { booked: true, date: req.date, time: req.time }\n     : { booked: false, reason: 'slot_unavailable' } }];"
        },
